<?xml version="1.0" encoding="utf-8"?>
<!-- recycle 2026-09-16 19:20 — upload 1 GB (Forn_cli HTTP 413) -->
<!-- recycle 2026-09-09 09:46 — corrige UnboundLocalError error_msg no wfastcgi -->
<!-- recycle 2026-09-08 18:40 — wfastcgi stdin em disco (POST 180 MB) -->
<!-- recycle 2026-09-08 18:20 — FastCGI arguments + timeout 3600s (arquivos ~180 MB) -->
<!-- recycle 2026-08-14 16:36 worker travado no De/Para Municipio (HTTP 500) -->
<!-- hardening OWASP/Invicti: HTTPS 301, HSTS, headers, verbs, remoção X-Powered-By -->
<configuration>

  <system.webServer>
    <handlers>
      <add name="Python FastCGI"
           path="*"
           verb="GET,HEAD,POST"
           modules="FastCgiModule"
           scriptProcessor="E:\SITES\DePara_Novo\venv\Scripts\python.exe|E:\SITES\DePara_Novo\venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <defaultDocument>
      <files>
        <add value="app.py" />
      </files>
    </defaultDocument>

    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto">
      <remove statusCode="413" subStatusCode="-1" />
      <error statusCode="413" path="static\erro-upload-grande.html" responseMode="File" />
    </httpErrors>
    <asp scriptErrorSentToBrowser="false" />

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <!-- Timeout para arquivos grandes. arguments DEVE coincidir com o scriptProcessor do handler,
         senão o IIS ignora estes timeouts (default ~90s) e mata o worker no meio da validação. -->
    <fastCgi>
      <application fullPath="E:\SITES\DePara_Novo\venv\Scripts\python.exe"
                   arguments="E:\SITES\DePara_Novo\venv\Lib\site-packages\wfastcgi.py"
                   activityTimeout="3600"
                   requestTimeout="3600"
                   idleTimeout="3600"
                   instanceMaxRequests="10000" />
    </fastCgi>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Requer URL Rewrite Module no IIS. Redirect permanente HTTP → HTTPS. -->
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <appSettings>
  <!-- Handler do Flask -->
  <add key="WSGI_HANDLER" value="app.app" />

  <!-- Caminho base absoluto -->
  <add key="PYTHONPATH" value="E:\SITES\DePara_Novo" />
  <add key="WSGI_APP" value="E:\SITES\DePara_Novo\app.py" />

  <!-- Logs -->
  <add key="WSGI_LOG" value="E:\SITES\DePara_Novo\logs\iis_flask.log" />
  <add key="WSGI_STDOUT" value="E:\SITES\DePara_Novo\logs\wfastcgi_stdout.log" />
  <add key="WSGI_STDERR" value="E:\SITES\DePara_Novo\logs\wfastcgi_stderr.log" />

  <!-- Configurações de ambiente -->
  <add key="PYTHONUNBUFFERED" value="1" />
  <add key="PYTHONIOENCODING" value="utf-8" />
  <add key="MAX_CONTENT_LENGTH" value="1073741824" />
  <add key="ARQUIVOS_PROJETOS_ROOT" value="E:\Arquivos dos Projetos" />
  <add key="WSGI_RESTART_FILE_REGEX" value=".*((\.py)|(\.config)|(\.env))$" />
  <add key="FLASK_ENV" value="production" />
  <add key="DEBUG" value="0" />
  <!-- Evita redirect duplicado na Flask quando o IIS já faz HTTP→HTTPS -->
  <add key="FORCE_HTTPS" value="false" />
  <add key="ENABLE_HSTS" value="true" />
  <add key="BLOCK_HTTP_OPTIONS" value="true" />
  <add key="PREFERRED_URL_SCHEME" value="https" />
  <add key="SESSION_COOKIE_SECURE" value="true" />
  <add key="SESSION_COOKIE_SAMESITE" value="Lax" />
</appSettings>


  <system.web>
    <compilation debug="false" />
    <httpRuntime executionTimeout="3600" maxRequestLength="1048576" />
  </system.web>

</configuration>
